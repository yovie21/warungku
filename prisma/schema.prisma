generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  kasir
  gudang
}

enum PoStatus {
  draft
  ordered
  received
  canceled
}

enum StockRef {
  sale
  purchase
  adjust
  return
}

enum PaymentMethod {
  tunai
  qris
  transfer
  debit
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  sales        Sale[]
  audits       AuditLog[]

  @@map("users")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(100)
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CatTree")
  products Product[]

  @@map("categories")
}

model Uom {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(30)
  symbol      String       @db.VarChar(10)
  products    Product[]
  productUoms ProductUom[]

  @@map("uoms")
}

model Product {
  id            Int            @id @default(autoincrement())
  sku           String         @unique @db.VarChar(30)
  name          String         @db.VarChar(200)
  barcode       String?        @unique @db.VarChar(50)
  categoryId    Int?           @map("category_id")
  uomId         Int?           @map("uom_id")
  price         Decimal        @db.Decimal(12, 2)
  costPrice     Decimal        @map("cost_price") @db.Decimal(12, 2)
  minStock      Int            @default(0) @map("min_stock")
  createdAt     DateTime       @default(now()) @map("created_at")
  category      Category?      @relation(fields: [categoryId], references: [id])
  uom           Uom?           @relation(fields: [uomId], references: [id])
  stockTx       StockTx[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  promos        Promo[]
  productUoms   ProductUom[]
  returns       SupplierReturn[]

  @@map("products")
}

model ProductUom {
  id               Int     @id @default(autoincrement())
  productId        Int     @map("product_id")
  uomId            Int     @map("uom_id")
  conversionFactor Int     @default(1) @map("conversion_factor")
  price            Decimal @db.Decimal(12, 2)
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom              Uom     @relation(fields: [uomId], references: [id])

  @@unique([productId, uomId])
  @@map("product_uoms")
}

model Supplier {
  id        Int              @id @default(autoincrement())
  name      String          @db.VarChar(150)
  contact   String?         @db.VarChar(100)
  phone     String?         @db.VarChar(30)
  email     String?         @db.VarChar(100)
  address   String?         @db.Text
  orders    PurchaseOrder[]
  returns   SupplierReturn[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          Int            @id @default(autoincrement())
  poNo        String?        @unique @map("po_no") @db.VarChar(24)
  supplierId  Int            @map("supplier_id")
  orderDate   DateTime       @default(now()) @map("order_date")
  status      PoStatus       @default(draft)
  totalAmount Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount  Decimal        @default(0) @map("paid_amount") @db.Decimal(12, 2)
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  items       PurchaseItem[]

  @@map("purchase_orders")
}

model Promo {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  productId Int?     @map("product_id")
  percent   Decimal? @db.Decimal(5, 2)
  amount    Decimal? @db.Decimal(12, 2)
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("promos")
}

model PurchaseItem {
  poId       Int           @map("po_id")
  productId  Int           @map("product_id")
  qty        Int
  unitPrice  Decimal       @map("unit_price") @db.Decimal(12, 2)
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id])

  @@id([poId, productId])
  @@map("purchase_items")
}

model StockTx {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  qtyChange  Int      @map("qty_change")
  refType    StockRef @map("ref_type")
  refId      Int?     @map("ref_id")
  createdAt  DateTime @default(now()) @map("created_at")
  product    Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("stock_tx")
}

model Sale {
  id             Int            @id @default(autoincrement())
  invoiceNo      String         @unique @map("invoice_no") @db.VarChar(24)
  userId         Int            @map("user_id")
  saleDate       DateTime       @default(now()) @map("sale_date")
  total          Decimal        @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  cashPaid       Decimal        @map("cash_paid") @db.Decimal(12, 2)
  changeGiven    Decimal        @map("change_given") @db.Decimal(12, 2)
  paymentMethod  PaymentMethod  @default(tunai) @map("payment_method")
  user           User           @relation(fields: [userId], references: [id])
  items          SaleItem[]

  @@map("sales")
}

model SaleItem {
  id               Int     @id @default(autoincrement())
  saleId           Int     @map("sale_id")
  productId        Int     @map("product_id")
  qty              Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)
  discount         Decimal @default(0) @db.Decimal(12, 2)
  uomSymbol        String? @map("uom_symbol") @db.VarChar(20)
  conversionFactor Int     @default(1) @map("conversion_factor")
  sale             Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

model SupplierReturn {
  id          Int      @id @default(autoincrement())
  supplierId  Int      @map("supplier_id")
  productId   Int      @map("product_id")
  qty         Int
  reason      String?  @db.VarChar(200)
  deductDebt  Boolean  @default(true) @map("deduct_debt")
  createdAt   DateTime @default(now()) @map("created_at")
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@map("supplier_returns")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  Int?     @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}
